{
  "name": "@jantra/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "electron dist/main.js",
    "dist": "electron-builder --config electron-builder.yml",
    "test": "node --import tsx --test src/windowSecurity.test.ts",
    "test:e2e": "electron --no-sandbox test/electron-security.e2e.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "42.11.18",
    "electron-builder": "26.18.0",
    "typescript": "^5.6.3"
  }
}
